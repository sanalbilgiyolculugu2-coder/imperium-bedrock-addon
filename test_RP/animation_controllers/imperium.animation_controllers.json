{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.imperium.soldier": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle",
            {
              "walk": "math.min(1.0, query.modified_move_speed * 1.35)"
            },
            {
              "shield_block": "query.mark_variant == 1 || query.is_sneaking"
            }
          ],
          "transitions": [
            {
              "attacking": "variable.attack_time > 0.0"
            }
          ],
          "blend_transition": 0.3
        },
        "attacking": {
          "animations": [
            "attack",
            {
              "walk": "math.min(1.0, query.modified_move_speed * 1.35)"
            }
          ],
          "transitions": [
            {
              "default": "variable.attack_time <= 0.0"
            }
          ],
          "blend_transition": 0.25
        }
      }
    }
  }
}