{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.imperium.soldier": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle",
            {
              "walk": "query.modified_move_speed > 0.05"
            },
            {
              "shield_block": "query.mark_variant == 1 || query.is_sneaking"
            }
          ],
          "transitions": [
            {
              "attacking": "variable.attack_time > 0.0"
            }
          ]
        },
        "attacking": {
          "animations": [
            "attack",
            "walk"
          ],
          "transitions": [
            {
              "default": "variable.attack_time <= 0.0"
            }
          ]
        }
      }
    }
  }
}